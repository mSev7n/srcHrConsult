# EmailJS (https://www.emailjs.com) — powers the Contact, Book Consultation
# and Eligibility Assessment forms. Create a free account, an Email Service,
# and one Email Template, then fill these in. All forms submit the same
# shape of data: a `summary` field (human-readable) plus one field per form
# input — build your EmailJS template around `{{summary}}` and it will work
# for every form on the site.
#
# These are NEXT_PUBLIC_ because EmailJS sends from the browser — there is
# no backend/server in this project. Copy this file to `.env.local` for
# local development, and add the same three variables in your Vercel
# project's Settings -> Environment Variables before deploying.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Analytics (optional) — leave blank to skip. When set, the matching script
# loads automatically with no other code changes needed.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
